{
    "name": "Word Puzzle",
    "short_name": "Word Puzzle",
    "description": "A privacy-first word puzzle game. 100% client-side, no data leaves your device.",
    "id": "./manifest.json",
    "start_url": "./",    "scope": "./",
    "display": "standalone",
    "orientation": "any",
    "lang": "en",
    "dir": "ltr",
    "background_color": "#0e1228",
    "theme_color": "#0e1228",
    "categories": ["games", "entertainment"],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ]
}
