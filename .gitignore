# Nothing generated or local.
node_modules/
dist/
*.local
.DS_Store
Thumbs.db

# Scratch artwork dropped in the app root (not brand/ or scripts/ inputs).
/ghosts.jpeg

# Working copies of the mark, kept while the icon set was being cut. Nothing reads
# them: the shipped set is brand/*.png plus each game's icon-*.png, generated by
# scripts/icon-variants.py and scripts/make_game_icons.py. Tracked once the cut is
# settled; these are the previews it was cut from.
/brand/icon-from-sheet.png
/games/pacman/icon/logo-on-dark.png
/icons/logo/

# Audit output, not part of the app. The findings land in CHANGELOG.md as fixes and
# the reusable prompts live in the master-prompts repo, so a per-app copy is a stale
# duplicate that cites paths from whichever machine wrote it.
/MASTER-AUDIT-REPORT.md

# Python bytecode. scripts/ is dev tooling and has no build step, so these only appear
# when something imports or byte-compiles one of the scripts.
__pycache__/
*.py[cod]

# Editor cruft
*.bak
*.swp
.idea/
.vscode/

# No game has build output any more: every game is served from its folder root
# (games/<id>/index.html) and none of them run a bundler.