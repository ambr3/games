{
    "name": "Seclusa Games",
    "short_name": "Seclusa",
    "description": "A privacy-first collection of browser games \u2014 Klondike, Pyramid, Blocks, Seclusa Munch and Word Puzzle. No ads, no tracking, no third-party requests. Everything stays on your device.",
    "id": "./manifest.json",
    "version": "0.1.32",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "display_override": [
        "standalone",
        "minimal-ui"
    ],
    "orientation": "any",
    "background_color": "#0d2340",
    "theme_color": "#0d2340",
    "lang": "en",
    "dir": "ltr",
    "categories": [
        "games",
        "entertainment"
    ],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ]
}
